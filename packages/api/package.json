    "async-retry": "^1.3.3",
    "hono": "^4.13.7",
    "json-stable-stringify": "^1.3.0",
    "libsql": "^0.5.29",
    "lodash": "^4.18.1",
    "nanoid": "^6.0.1",
    "openai": "^7.21.0",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },

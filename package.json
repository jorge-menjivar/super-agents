{
  "name": "super-agents",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @super-agents/api dev",
    "dev:api:worker": "pnpm --filter @super-agents/api dev:worker",
    "db:upgrade": "pnpm --filter @super-agents/api exec tsx scripts/upgrade-dev-db.mjs",
    "dev:web": "pnpm --filter @super-agents/web dev",
    "build": "turbo build",
    "build:api": "pnpm --filter @super-agents/api build",
    "build:web": "pnpm --filter @super-agents/web build",
    "start": "pnpm --filter @super-agents/web start",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "format:fix": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check . --write",
    "typecheck": "turbo typecheck && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:all": "scripts/e2e-postgres.sh up && pnpm build && E2E_POSTGREST_URL=http://127.0.0.1:3001 playwright test",
    "test:e2e:postgres": "scripts/e2e-postgres.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "verify:worker": "./scripts/check-worker-runtime.sh",
    "verify:container": "./scripts/check-container-image.sh",
    "deploy:api": "pnpm --filter @super-agents/api deploy"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.9",
    "openai": "^7.21.0",
    "react": "19.2.8",
    "turbo": "^2.10.12",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-router": "^1.170.32",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "overrides": {
      "react-is": "^19.1.0",
      "markdown-it": "13.0.2",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.7",
      "react-dom": "19.2.8"
    }
  }
}
